{
  "version": 1,
  "rendering": {
    "opaque_renderer": "auto",
    "shadows_directional_enabled": true,
    "shadow_map_size": 2048,
    "texture_mipmaps_enabled": true,
    "texture_anisotropy": 8,
    "msaa_samples": 1,
    "vsync": true,
    "bloom": {
      "enabled": true,
      "intensity": 0.15,
      "threshold": 2.5,
      "threshold_softness": 0.4
    }
  },
  "projectiles": {
    "brightness": 5.0,
    "spark_brightness": 25.0
  },
  "lighting": {
    "ambient_brightness": 70.0,
    "directional_brightness": 8000.0
  },
  "camera": {
    "fov_first_person_degrees": 90.0,
    "fov_top_down_degrees": 45.0,
    "topdown_margin": 1.15,
    "topdown_tilt_degrees": 35.0,
    "rearview": {
      "enabled": true,
      "fov_degrees": 90.0,
      "width_ratio": 0.20,
      "height_ratio": 0.20
    },
    "shake": {
      "duration_secs": 0.3,
      "intensity": 0.2,
      "hit_vertical": 0.2,
      "fall_vertical": 0.5
    }
  },
  "input": {
    "mouse_sensitivity": 0.002
  },
  "hud": {
    "reference_width": 1920.0,
    "font_sizes": {
      "player_list": 18.0,
      "score": 16.0,
      "message_feed": 18.0,
      "floating_label": 40.0,
      "banner": 40.0,
      "quest_panel": 16.0
    },
    "message_feed": {
      "entry_duration_secs": 10.0,
      "max_entries": 5
    },
    "floating_labels": {
      "height_above_character": 0.5
    },
    "health_bars": {
      "floating_player_aspect": 0.056,
      "floating_actor_aspect": 0.129,
      "player_list_width": 160.0,
      "player_list_height": 8.0
    },
    "banner": {
      "quest_announcement_duration_secs": 10.0,
      "quest_completed_duration_secs": 5.0,
      "death_duration_secs": 3.0,
      "death_text": "You died!",
      "fade_duration_secs": 0.8
    },
    "quest_panel": {
      "bar_width": 160.0,
      "bar_height": 8.0
    },
    "death_overlay": {
      "duration_secs": 3.0,
      "fade_duration_secs": 0.8
    }
  },
  "barriers": {
    "alpha_min": 0.15,
    "alpha_max": 0.35,
    "pulse_hz": 0.5
  },
  "grass": {
    "enabled": true,
    "tufts_per_m2": 16.0,
    "wind_strength": 0.05,
    "wind_speed": 2.5,
    "wind_direction_degrees": 30.0
  },
  "debug": {
    "collider_boxes": false
  }
}
